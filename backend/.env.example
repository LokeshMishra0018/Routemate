# RouteMate Backend Environment Variables Example
# Copy this file to .env and configure appropriate values for your environment.

# Server Environment (development | test | production)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS - Comma-separated list of allowed origins (In production, wildcard * is disallowed)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MongoDB Atlas
# In production, MONGODB_URI and MONGODB_DB_NAME MUST be explicitly configured.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=routemate_dev

# JWT Authentication
# In production, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be random strings >= 32 characters.
JWT_ACCESS_SECRET=development-jwt-access-secret-minimum-32-chars!!
JWT_REFRESH_SECRET=development-jwt-refresh-secret-minimum-32-chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Email Delivery
EMAIL_FROM=noreply@routemate.app

# Private Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads/private

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
# Optional comma-separated IP allowlist (empty by default; localhost is NOT exempt by default)
RATE_LIMIT_ALLOW_LIST=

# Redis (Optional in Development, recommended for production distributed rate limiting & pub/sub)
# REDIS_URL=redis://localhost:6379

# Socket.IO CORS (In production, wildcard * is disallowed)
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:3000
